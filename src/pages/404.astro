---
/*
  404. Copy: docs/COPY.md > 404. Visual (SITE_SPEC): a tenon that does not fit its slot.
  The mark's stem is shifted sideways: it slides up, butts against the bar because the tongue
  misses the slot, and drops back a little. Reduced motion: the misaligned end state, still.
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import { MARKS } from '../data/logo-marks';

const m = MARKS.a;
---

<BaseLayout title="Page not found | Tenonpath" noindex>
  <section class="container nf">
    <svg class="nf__mark" viewBox="-4 -2 40 40" role="img" aria-label="A joint that does not fit: the tenon misses its slot">
      <path d={m.fixed} fill="currentColor" class="nf__bar"></path>
      <!-- Stem shifted 6 units right: its tongue lands on solid bar, not in the slot -->
      <g class="nf__stem" data-nf-stem>
        <path d={m.tenon} fill="currentColor" transform="translate(6 4)"></path>
      </g>
    </svg>
    <div class="nf__text">
      <h1 class="t-display">This piece doesn't fit.</h1>
      <p class="t-lead">The page you were looking for isn't here.</p>
      <a class="text-cta" href="/">
        Back to the homepage
        <svg class="btn__arrow" viewBox="0 0 16 10" aria-hidden="true"><path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.25"></path></svg>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: var(--space-7);
    align-items: center;
    min-height: calc(100svh - var(--header-h) - 12rem);
    padding-block: var(--space-9);
  }
  .nf__mark {
    width: clamp(8rem, 6rem + 10vw, 14rem);
    height: auto;
    color: var(--brass);
    overflow: visible;
  }
  .nf__bar {
    color: var(--bone-dim);
  }
  .nf__text {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  @media (min-width: 900px) {
    .nf {
      grid-template-columns: auto 1fr;
      gap: var(--space-9);
    }
  }
</style>

<script>
  // Slide up, butt against the bar (the tongue misses the slot), drop back. Once, on load.
  const stem = document.querySelector<SVGGElement>('[data-nf-stem]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (stem && !reduced) {
    stem.animate(
      [
        { transform: 'translate(0px, 12px)', opacity: 0, offset: 0, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
        { transform: 'translate(0px, -1px)', opacity: 1, offset: 0.55, easing: 'cubic-bezier(0.215, 0.61, 0.355, 1)' },
        { transform: 'translate(0px, 0px)', opacity: 1, offset: 1 },
      ],
      { duration: 700, delay: 200, fill: 'both' },
    );
  }
</script>
