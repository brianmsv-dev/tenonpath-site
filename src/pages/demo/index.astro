---
/*
  /demo: full-screen interactive demo dashboard (docs/SITE_SPEC.md > /demo page).
  Our studio chrome (banner with the DEMO DATA label, Tenonpath logo, "Make it yours", frame) in
  the Tenonpath brand, around the client product, which has its own neutral theme.
  No site header or footer, no smooth scroll or scroll motion here.
*/
import '../../styles/global.css';
import LogoMark from '../../components/LogoMark.astro';
import DemoApp from '../../components/demo/DemoApp.astro';
import Seo from '../../components/Seo.astro';
import { NAME } from '../../lib/demo';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title="Demo dashboard | Tenonpath" description="Click around a working dashboard for a fictional commercial real estate portfolio." />
    <meta name="theme-color" content="#0e1116" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/GeneralSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/IBMPlexMono-Medium.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="demo-page">
    <a class="skip-link" href="#dashboard">Skip to dashboard</a>
    <div class="demo-banner">
      <p>
        This is a demo with fictional data. Want this for your portfolio? <a class="link" href="/#contact">Start a project</a>.
      </p>
      <p class="demo-banner__label" aria-hidden="true">DEMO DATA</p>
    </div>

    <header class="demo-top">
      <a href="/" class="demo-top__brand" aria-label="Tenonpath home" data-logo-hover>
        <LogoMark concept="a" size={24} title="" />
        <span class="wordmark" aria-hidden="true">tenonpath</span>
      </a>
    </header>

    <main id="dashboard" class="demo-main" tabindex="-1">
      <h1 class="visually-hidden">{NAME} demo dashboard</h1>
      <DemoApp variant="full" />
    </main>

    <script>
      import '../../scripts/demo';
      import '../../scripts/logo';
    </script>
  </body>
</html>

<style>
  .demo-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-3) var(--pad-x);
    background: var(--ink-2);
    border-bottom: 1px solid var(--rule);
    color: var(--bone-dim);
    font-size: var(--fs-small);
  }
  .demo-banner .link {
    color: var(--bone);
    text-decoration-color: var(--brass);
  }
  /* In the banner, part of the page flow: it can never sit on top of data */
  .demo-banner__label {
    flex: none;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--brass-soft);
    color: var(--brass);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }
  .demo-top {
    padding: var(--space-4) var(--pad-x) 0;
  }
  .demo-top__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    text-decoration: none;
  }
  .demo-top__brand .wordmark {
    font-size: 1.25rem;
  }
  .demo-main {
    padding: 0 var(--pad-x) var(--space-9);
  }
  .demo-main:focus {
    outline: none;
  }
  /* Drafting frame around the client product: our chrome, their product */
  .demo-main :global(.demo) {
    outline: 1px solid var(--rule-strong);
    outline-offset: 6px;
  }
</style>
