---
// Holding page until phase 2 (hero) and phase 3 (sections). Not indexed until launch.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Tenonpath" noindex>
  <section class="section container holding">
    <h1 class="wordmark holding__mark" data-reveal>tenonpath</h1>
    <p data-reveal><a class="link" href="mailto:hello@tenonpath.com">hello@tenonpath.com</a></p>
  </section>
</BaseLayout>

<style>
  .holding {
    display: grid;
    gap: var(--space-5);
    min-height: 60vh;
    align-content: center;
  }
  .holding__mark {
    font-size: var(--fs-hero);
  }
</style>
