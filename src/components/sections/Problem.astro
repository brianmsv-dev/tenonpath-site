---
// 02 Problem. Copy: docs/COPY.md > 02 Problem. Motion: src/scripts/sections.ts (problem).
// Markup is the end state: every task struck through in brass and dimmed, the answer showing.
// The strike is a background line on the inline task text (box-decoration-break: clone), so it
// covers only the words, follows wrapped lines, and never crosses the timestamp.
import SectionHead from './SectionHead.astro';

const week = [
  ['MON 08:10', 'Export the rent roll'],
  ['MON 08:40', 'Paste it into the master spreadsheet'],
  ['MON 09:30', 'Check the task board for what moved'],
  ['MON 11:15', "Search the inbox for the broker's update"],
  ['TUE 14:00', 'Investor asks for collections. Rebuild the numbers'],
  ['WED 10:00', 'Find out the spreadsheet broke on Monday'],
];
---

<section class="home-section problem" id="problem" aria-labelledby="problem-title">
  <div class="container grid-12">
    <div class="problem__head">
      <SectionHead number="02" label="THE PROBLEM" title="Five systems. One analyst. Every Monday." titleId="problem-title">
        <p class="t-lead measure-text">
          The data is all there. It is just in five places. So someone exports, pastes, reconciles and rebuilds the same
          numbers every week, and the answer to "what's our occupancy?" still takes an hour.
        </p>
        </SectionHead>
    </div>

    <div class="problem__week" data-week>
      <ol role="list" class="week">
        {
          week.map(([when, what]) => (
            <li class="week__row" data-week-row>
              <span class="week__when t-mono">{when}</span>
              <span class="week__what"><s class="week__text" data-week-text>{what}</s></span>
            </li>
          ))
        }
      </ol>
      <p class="week__answer" data-week-answer>Or: open one dashboard.</p>
    </div>
  </div>
</section>

<style>
  .problem__head,
  .problem__week {
    grid-column: 1 / -1;
  }
  .problem__week {
    margin-top: var(--space-8);
  }

  .week {
    border-top: 1px solid var(--rule);
  }
  .week__row {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
    color: var(--bone-dim);
  }
  .week__when {
    font-size: var(--fs-small);
    color: var(--bone-dim);
  }
  .week__what {
    min-width: 0;
  }
  /* Struck task text: a 1.5px brass line drawn as a background on the inline text, cloned onto
     every wrapped line. Animated by growing background-size from 0% to 100%. */
  .week__text {
    text-decoration: none;
    color: var(--bone-dim);
    background-image: linear-gradient(var(--brass), var(--brass));
    background-repeat: no-repeat;
    background-position: 0 60%; /* middle of the x-height, from General Sans metrics */
    background-size: 100% 1.5px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .week__answer {
    margin-top: var(--space-6);
    font-size: var(--fs-h3);
    font-weight: 500;
    color: var(--brass);
  }

  @media (min-width: 1024px) {
    .problem__head {
      grid-column: 1 / span 5;
    }
    .problem__week {
      grid-column: 7 / span 6;
      margin-top: 0;
    }
  }
</style>
