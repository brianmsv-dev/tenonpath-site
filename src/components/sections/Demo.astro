---
/*
  04 Live demo. Copy: docs/COPY.md > 04 Live demo.
  The cut-down demo (all five views, company name and theme controls, long tables capped at
  8 rows) is lazy loaded: when the frame comes within about 800px of the viewport, /demo/embed/
  is fetched, its styles are added to the page, its [data-demo] element is moved into the frame
  and src/scripts/demo.ts is imported and run. The frame grows to fit; there is no inner scroll.
*/
import SectionHead from './SectionHead.astro';
import MeasureLine from '../MeasureLine.astro';
---

<section class="home-section livedemo" id="demo" aria-labelledby="demo-title">
  <div class="container">
    <div class="grid-12 livedemo__intro">
      <div class="livedemo__head">
        <SectionHead number="04" label="LIVE DEMO" title="Don't take our word for it." titleId="demo-title" />
      </div>
      <p class="t-lead livedemo__body" data-reveal>
        Click around a working dashboard for a fictional industrial portfolio. Same build quality you would get,
        connected to your own systems.
      </p>
    </div>

    <figure class="livedemo__figure">
      <MeasureLine label="1440 PX" />
      <div class="livedemo__frame">
        <span class="livedemo__corner livedemo__corner--tl" aria-hidden="true"></span>
        <span class="livedemo__corner livedemo__corner--tr" aria-hidden="true"></span>
        <span class="livedemo__corner livedemo__corner--bl" aria-hidden="true"></span>
        <span class="livedemo__corner livedemo__corner--br" aria-hidden="true"></span>
        <div class="livedemo__slot" data-demo-slot data-src="/demo/embed/" aria-busy="true">
          <p class="t-label livedemo__status" data-demo-status>Loading the demo</p>
        </div>
      </div>
      <MeasureLine label="LIVE DEMO / FICTIONAL DATA" />
    </figure>

    <div class="livedemo__foot">
      <a class="btn btn--secondary" href="/demo">
        Open the full demo
        <svg class="btn__arrow" viewBox="0 0 16 10" aria-hidden="true"><path d="M0 5h14M10 1l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.25"></path></svg>
      </a>
      <p class="t-small t-dim">Fictional portfolio. Real build quality.</p>
    </div>
  </div>
</section>

<style>
  .livedemo__intro {
    row-gap: var(--space-5);
    align-items: end;
  }
  .livedemo__head,
  .livedemo__body {
    grid-column: 1 / -1;
  }
  .livedemo__body {
    max-width: 40rem;
  }

  .livedemo__figure {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-8) 0 0;
  }
  /* The frame grows to fit the demo: no inner scroll. While loading it holds a minimum height;
     the demo loads about 800px before the frame is on screen, so the growth happens off-screen. */
  .livedemo__frame {
    position: relative;
    background-color: var(--ink);
    border: 1px solid var(--rule-strong);
  }
  .livedemo__slot {
    padding: var(--space-2) var(--space-4) var(--space-5);
  }
  .livedemo__slot[aria-busy='true'] {
    min-height: 90rem;
  }
  .livedemo__status {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--bone-dim);
    font-size: var(--fs-micro);
  }
  /* Registration marks at the frame corners, like a drawing sheet */
  .livedemo__corner {
    position: absolute;
    z-index: 1;
    width: 14px;
    height: 14px;
    border-color: var(--brass);
    border-style: solid;
    border-width: 0;
    pointer-events: none;
  }
  .livedemo__corner--tl { top: -6px; left: -6px; border-top-width: 1px; border-left-width: 1px; }
  .livedemo__corner--tr { top: -6px; right: -6px; border-top-width: 1px; border-right-width: 1px; }
  .livedemo__corner--bl { bottom: -6px; left: -6px; border-bottom-width: 1px; border-left-width: 1px; }
  .livedemo__corner--br { bottom: -6px; right: -6px; border-bottom-width: 1px; border-right-width: 1px; }

  .livedemo__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-6);
  }

  @media (min-width: 900px) {
    .livedemo__slot {
      padding: var(--space-3) var(--space-6) var(--space-7);
    }
    .livedemo__slot[aria-busy='true'] {
      min-height: 48rem;
    }
  }
  @media (min-width: 1024px) {
    .livedemo__head {
      grid-column: 1 / span 6;
    }
    .livedemo__body {
      grid-column: 8 / span 5;
    }
  }
</style>

<script>
  const slot = document.querySelector<HTMLElement>('[data-demo-slot]');

  async function load(el: HTMLElement) {
    const status = el.querySelector<HTMLElement>('[data-demo-status]');
    try {
      const res = await fetch(el.dataset.src!);
      if (!res.ok) throw new Error(String(res.status));
      const doc = new DOMParser().parseFromString(await res.text(), 'text/html');

      // Bring the embed's styles over (stylesheets and inlined <style>), once.
      doc.head.querySelectorAll<HTMLLinkElement | HTMLStyleElement>('link[rel="stylesheet"], style').forEach((node) => {
        if (node instanceof HTMLLinkElement) {
          const href = node.getAttribute('href');
          if (!href || document.head.querySelector(`link[rel="stylesheet"][href="${href}"]`)) return;
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = href;
          document.head.append(link);
        } else {
          const style = document.createElement('style');
          style.textContent = node.textContent;
          document.head.append(style);
        }
      });

      const root = doc.querySelector<HTMLElement>('[data-demo]');
      if (!root) throw new Error('no demo root');
      const { initDemo } = await import('../../scripts/demo');
      el.replaceChildren(document.adoptNode(root));
      el.removeAttribute('aria-busy');
      initDemo(root);
    } catch {
      el.removeAttribute('aria-busy');
      if (status) {
        status.innerHTML = 'The demo did not load here. <a class="link" href="/demo">Open the full demo</a>';
      }
    }
  }

  if (slot) {
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            load(slot);
          }
        },
        { rootMargin: '800px 0px' },
      );
      io.observe(slot);
    } else {
      load(slot);
    }
  }
</script>
