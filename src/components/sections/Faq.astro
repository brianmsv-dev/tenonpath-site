---
// 09 FAQ. Copy: docs/COPY.md > 09 FAQ (headline here, questions via src/data/faq.ts).
// The question list and its FAQPage schema come from the shared Accordion component.
import SectionHead from './SectionHead.astro';
import Accordion from '../Accordion.astro';
import { FAQ } from '../../data/faq';
---

<section class="home-section faq" id="faq" aria-labelledby="faq-title">
  <div class="container grid-12">
    <div class="faq__head">
      <SectionHead number="09" label="QUESTIONS" title="Before you ask." titleId="faq-title" />
    </div>
    <div class="faq__list" data-reveal>
      <Accordion items={FAQ} />
    </div>
  </div>
</section>

<style>
  .faq__head,
  .faq__list {
    grid-column: 1 / -1;
  }
  .faq__list {
    margin-top: var(--space-6);
  }
  @media (min-width: 1024px) {
    .faq__head {
      grid-column: 1 / span 4;
    }
    .faq__list {
      grid-column: 5 / span 8;
      margin-top: 0;
    }
  }
</style>
