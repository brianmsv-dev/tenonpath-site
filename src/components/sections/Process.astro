---
// 05 How we work. Copy: docs/COPY.md > 05 How we work.
// Four steps on a measured line: horizontal from 900px, vertical below. As the section scrolls
// through, a brass line draws along it and each step's tick locks in (src/scripts/sections.ts).
// Markup is the end state: line fully drawn, all ticks locked.
import SectionHead from './SectionHead.astro';

const steps = [
  ['Discovery call.', '30 minutes, free. You show us your systems and what you wish you could see.'],
  ['Fixed scope and price.', 'Within three business days you get a written scope, timeline and fixed price. No hourly surprises.'],
  ['Build.', 'Weekly previews you can click through, so the result is exactly what you asked for.'],
  ['Launch and support.', 'We host, monitor and keep it running, with small changes included on a monthly plan.'],
];
---

<section class="home-section process" id="process" aria-labelledby="process-title">
  <div class="container">
    <SectionHead number="05" label="PROCESS" title="Measured twice. Built once." titleId="process-title" />

    <div class="steps" data-steps>
      <div class="steps__track" aria-hidden="true">
        <span class="steps__base"></span>
        <span class="steps__progress" data-steps-progress></span>
      </div>
      <ol role="list" class="steps__list">
        {
          steps.map(([title, body], i) => (
            <li class="step is-locked" data-step>
              <span class="step__tick" aria-hidden="true" data-step-tick />
              <span class="t-label step__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="t-h4 step__title">{title}</h3>
              <p class="t-dim step__body">{body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .steps {
    --tick: 15px;
    position: relative;
    margin-top: var(--space-8);
  }
  .steps__track {
    position: absolute;
    /* vertical layout: the line runs down the left edge through every tick */
    left: calc(var(--tick) / 2);
    top: 0;
    bottom: 0;
    width: 1px;
  }
  .steps__base,
  .steps__progress {
    position: absolute;
    inset: 0;
  }
  .steps__base {
    background: var(--rule-strong);
  }
  .steps__progress {
    background: var(--brass);
    transform-origin: top center;
  }

  .steps__list {
    display: grid;
    gap: var(--space-7);
  }
  .step {
    position: relative;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding-left: calc(var(--tick) + var(--space-5));
  }
  /* The tick: a short bar across the line that turns brass when the line reaches it */
  .step__tick {
    position: absolute;
    left: 0;
    top: 0.2rem;
    width: var(--tick);
    height: 1px;
    background: var(--rule-strong);
    transition: background-color 0.2s var(--ease-out);
  }
  .step__tick::after {
    content: '';
    position: absolute;
    left: calc(var(--tick) / 2 - 3px);
    top: -3px;
    width: 7px;
    height: 7px;
    background: var(--ink);
    border: 1px solid var(--rule-strong);
    transition:
      background-color 0.2s var(--ease-out),
      border-color 0.2s var(--ease-out);
  }
  .step.is-locked .step__tick {
    background: var(--brass);
  }
  .step.is-locked .step__tick::after {
    background: var(--brass);
    border-color: var(--brass);
  }
  .step__num {
    color: var(--brass);
  }
  .step__body {
    max-width: 34ch;
  }

  @media (min-width: 900px) {
    .steps {
      padding-top: var(--space-6);
    }
    .steps__track {
      left: 0;
      right: 0;
      top: 0;
      bottom: auto;
      width: auto;
      height: 1px;
    }
    .steps__progress {
      transform-origin: left center;
    }
    .steps__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--gutter);
    }
    .step {
      padding-left: 0;
      padding-top: var(--space-5);
    }
    .step__tick {
      top: calc(-1 * var(--space-6) - 7px);
      left: 0;
      width: 1px;
      height: 15px;
    }
    .step__tick::after {
      left: -3px;
      top: 4px;
    }
  }
</style>
