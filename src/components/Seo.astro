---
/*
  Per-page SEO tags (docs/SITE_SPEC.md > SEO): title, description, canonical URL, robots,
  Open Graph and Twitter card, optional JSON-LD. The share image is public/og.png
  (npm run brand). Canonical URLs use the site URL from astro.config.mjs, with a trailing slash
  to match the built directory URLs.
*/
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  /** Structured data objects, each rendered as its own JSON-LD script. */
  schema?: object[];
}
const { title, description, noindex = false, schema = [] } = Astro.props;
const site = Astro.site ?? new URL('https://tenonpath.com');
const path = Astro.url.pathname.endsWith('/') || Astro.url.pathname.includes('.') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(path, site).href;
const image = new URL('/og.png', site).href;
---

<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Tenonpath" />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Tenonpath. Your systems, joined." />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={image} />
{schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
