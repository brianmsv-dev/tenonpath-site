---
// Site footer. Copy: docs/COPY.md > Footer.
import MeasureLine from './MeasureLine.astro';
import LogoMark from './LogoMark.astro';

const links = [
  { href: '/demo', label: 'Demo' },
  { href: '/real-estate', label: 'Real estate' },
  { href: '/privacy', label: 'Privacy' },
];
---

<footer class="site-footer">
  <div class="container">
    <MeasureLine variant="ruler" />
    <div class="grid-12 site-footer__grid">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo" aria-label="Tenonpath home" data-logo-hover>
          <LogoMark concept="a" size={32} title="" />
          <span class="wordmark site-footer__wordmark" aria-hidden="true">tenonpath</span>
        </a>
        <p class="t-dim">Tenonpath. Dashboards, integrations and web apps, built to fit.</p>
      </div>
      <div class="site-footer__contact">
        <a class="link" href="mailto:hello@tenonpath.com">hello@tenonpath.com</a>
        <p class="t-dim">Nairobi, Kenya. Working with clients in the US and worldwide.</p>
      </div>
      <nav class="site-footer__nav" aria-label="Footer">
        <ul role="list">
          {links.map((l) => (
            <li>
              <a class="site-footer__link t-label" href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <p class="site-footer__legal t-label">© 2026 Tenonpath</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-8) var(--space-6);
    font-size: var(--fs-small);
  }
  .site-footer__grid {
    row-gap: var(--space-6);
    padding-top: var(--space-7);
  }
  .site-footer__brand,
  .site-footer__contact,
  .site-footer__nav {
    grid-column: 1 / -1;
  }
  .site-footer__brand,
  .site-footer__contact {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    justify-self: start;
    text-decoration: none;
  }
  .site-footer__wordmark {
    font-size: 1.75rem;
  }
  .site-footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
  }
  .site-footer__link {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--bone-dim);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }
  .site-footer__link:hover {
    color: var(--bone);
  }
  .site-footer__legal {
    margin-top: var(--space-8);
    color: var(--bone-dim);
  }

  @media (min-width: 720px) {
    .site-footer__brand {
      grid-column: 1 / span 5;
    }
    .site-footer__contact {
      grid-column: 6 / span 4;
    }
    .site-footer__nav {
      grid-column: 10 / span 3;
    }
    .site-footer__nav ul {
      flex-direction: column;
      gap: 0;
    }
  }
</style>
