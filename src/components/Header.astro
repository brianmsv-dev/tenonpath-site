---
// Site header. Copy: docs/COPY.md > Header. Behaviour: docs/SITE_SPEC.md > Global.
// The mark is not chosen yet (phase 1 review gate), so the header shows the wordmark only.
const links = [
  { href: '/#demo', label: 'Work' },
  { href: '/#services', label: 'Services' },
  { href: '/#process', label: 'Process' },
  { href: '/#pricing', label: 'Pricing' },
];
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="wordmark site-header__brand" aria-label="Tenonpath home">tenonpath</a>

    <nav class="site-nav" aria-label="Main">
      <ul role="list" class="site-nav__list">
        {links.map((l) => (
          <li>
            <a class="site-nav__link" href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
      <a class="btn btn--primary site-nav__cta" href="/#contact">Start a project</a>
    </nav>

    <button
      class="menu-toggle t-label"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span data-menu-label>Menu</span>
      <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div id="mobile-menu" class="mobile-menu" data-menu hidden>
    <nav class="container mobile-menu__nav" aria-label="Main">
      <ol role="list" class="mobile-menu__list">
        {links.map((l, i) => (
          <li>
            <a class="mobile-menu__link" href={l.href}>
              <span class="mobile-menu__num t-label">{String(i + 1).padStart(2, '0')}</span>
              <span>{l.label}</span>
            </a>
          </li>
        ))}
      </ol>
      <a class="btn btn--primary mobile-menu__cta" href="/#contact">Start a project</a>
      <a class="link t-label mobile-menu__mail" href="mailto:hello@tenonpath.com">hello@tenonpath.com</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    background: var(--ink);
    border-bottom: 1px solid transparent;
    transition:
      transform var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--rule);
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }
  .site-header__brand {
    font-size: 1.5rem;
    text-decoration: none;
  }

  .site-nav {
    display: none;
    align-items: center;
    gap: var(--space-6);
  }
  .site-nav__list {
    display: flex;
    gap: var(--space-6);
  }
  .site-nav__link {
    display: inline-block;
    padding-block: var(--space-2);
    color: var(--bone-dim);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }
  .site-nav__link:hover {
    color: var(--bone);
  }
  .site-nav__cta {
    min-height: 2.5rem;
    --btn-pad-y: 0.5rem;
    --btn-pad-x: 1rem;
    font-size: 0.9375rem;
  }

  /* Menu toggle: mono label plus two hairlines that close into a single line */
  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    padding: 0 var(--space-2);
    margin-right: calc(-1 * var(--space-2));
    background: none;
    border: 0;
    color: var(--bone);
  }
  .menu-toggle__bars {
    display: grid;
    gap: 5px;
    width: 20px;
  }
  .menu-toggle__bars span {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform var(--dur-1) var(--ease-out);
  }
  .menu-toggle__bars span:last-child {
    width: 60%;
    justify-self: end;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:first-child {
    transform: translateY(3px);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars span:last-child {
    transform: translateY(-3px) scaleX(1.667);
    transform-origin: right;
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    background: var(--ink);
    border-top: 1px solid var(--rule);
    overflow-y: auto;
  }
  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }
  .mobile-menu__list {
    border-top: 1px solid var(--rule);
  }
  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 1.375rem;
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    text-decoration: none;
  }
  .mobile-menu__num {
    color: var(--brass);
  }
  .mobile-menu__cta {
    align-self: flex-start;
  }
  .mobile-menu__mail {
    color: var(--bone-dim);
  }

  @media (min-width: 900px) {
    .site-nav {
      display: flex;
    }
    .menu-toggle,
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  import { lockScroll, unlockScroll } from '../scripts/motion';

  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const label = header.querySelector<HTMLElement>('[data-menu-label]')!;
  const menu = header.querySelector<HTMLElement>('[data-menu]')!;

  /* Hide on scroll down, show on scroll up. Lenis drives native scroll, so window.scrollY is accurate. */
  let lastY = window.scrollY;
  let ticking = false;
  const THRESHOLD = 8;

  function update() {
    ticking = false;
    const y = window.scrollY;
    const open = toggle.getAttribute('aria-expanded') === 'true';
    header.classList.toggle('is-scrolled', y > 4);
    if (open || header.contains(document.activeElement)) {
      header.classList.remove('is-hidden');
    } else if (Math.abs(y - lastY) > THRESHOLD) {
      header.classList.toggle('is-hidden', y > lastY && y > header.offsetHeight);
    }
    lastY = y;
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true },
  );
  update();

  // Keyboard users tabbing into a hidden header bring it back.
  header.addEventListener('focusin', () => header.classList.remove('is-hidden'));

  /* Mobile menu */
  function setOpen(open: boolean) {
    toggle.setAttribute('aria-expanded', String(open));
    label.textContent = open ? 'Close' : 'Menu';
    menu.hidden = !open;
    if (open) {
      lockScroll();
      header.classList.remove('is-hidden');
      menu.querySelector<HTMLElement>('a')?.focus();
    } else {
      unlockScroll();
    }
  }

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  // Keep focus inside the open menu (toggle + menu links).
  header.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || toggle.getAttribute('aria-expanded') !== 'true') return;
    const items = [toggle, ...menu.querySelectorAll<HTMLElement>('a')];
    const first = items[0];
    const last = items[items.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
    if (e.matches && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
  });
</script>
